  {
    "type": "ia.input.button",
    "version": 0,
    "props": {
      "text": "START",
      "style": {
        "backgroundColor": "#1565C0",
        "color": "#FFFFFF",
        "fontSize": "20px",
        "fontWeight": "bold"
      }
    },
    "events": {
      "component": {
        "onActionPerformed": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "    tags = [\"[default]StartButton\"]\n    system.tag.writeBlocking(tags, [True])\n    import time\n    time.sleep(0.5)\n    system.tag.writeBlocking(tags, [False])"
          }
        }
      }
    },
    "meta": {
      "name": "StartBtn"
    },
    "position": {
      "x": 60,
      "y": 200,
      "width": 180,
      "height": 70
    },
    "custom": {}
  },
